---
/** Kurzliste aller Mitglieder eines Gremiums, verlinkt auf die Personenkarten */
interface Props { titel: string; personen: { id: string; name: string }[]; }
const { titel, personen } = Astro.props;
---
<div class="besetzung">
  <h3>{titel}</h3>
  <ul>{personen.map((p) => <li><a href={`#${p.id}`}>{p.name}</a></li>)}</ul>
</div>
<style>
  .besetzung { margin-bottom: 1.75rem; }
  .besetzung h3 { font-size: 1rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--igd-grau); margin-bottom: 0.5rem; }
  ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; font-weight: 600; }
</style>
