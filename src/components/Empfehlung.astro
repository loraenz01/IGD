---
/** Infobox «Unsere Empfehlung» (Briefing 5.7 / 7.6) */
interface Props {
  empfehlung: 'Ja' | 'Nein' | 'Stimmfreigabe' | 'Kenntnisnahme';
  begruendung?: string;
}
const { empfehlung, begruendung } = Astro.props;
const klasse = empfehlung.toLowerCase();
const symbol = { ja: '✓', nein: '✕', stimmfreigabe: '–', kenntnisnahme: 'i' }[klasse];
---
<aside class={`empfehlung empfehlung--${klasse}`} aria-label="Unsere Empfehlung">
  <p class="empfehlung__kopf">
    <span class="empfehlung__symbol" aria-hidden="true">{symbol}</span>
    <span>Unsere Empfehlung: <strong>{empfehlung}</strong></span>
  </p>
  {begruendung && <p class="empfehlung__text">{begruendung}</p>}
  <slot />
</aside>

<style>
  .empfehlung {
    border-left: 6px solid var(--farbe);
    background: var(--igd-hell);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 1rem 1.25rem;
    margin-block: 1rem;
    --farbe: var(--igd-grau);
  }
  .empfehlung--ja { --farbe: var(--igd-ja); }
  .empfehlung--nein { --farbe: var(--igd-nein); }
  .empfehlung__kopf { display: flex; align-items: center; gap: 0.75rem; margin: 0; font-size: 1.15rem; }
  .empfehlung__kopf strong { font-weight: 800; }
  .empfehlung__symbol {
    display: grid; place-items: center; flex: none;
    width: 2rem; height: 2rem; border-radius: 50%;
    background: var(--farbe); color: var(--igd-weiss); font-weight: 800;
  }
  .empfehlung__text { margin: 0.5rem 0 0; }
</style>
