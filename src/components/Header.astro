---
import Logo from './Logo.astro';
import { NAV } from '../lib/site';

const pfad = Astro.url.pathname;
const aktiv = (href: string) => pfad === href || pfad.startsWith(href);
---
<header class="kopf">
  <div class="container kopf__innen">
    <a href="/" class="kopf__marke" aria-label="IG Diessbach – zur Startseite">
      <Logo ton="weiss" class="kopf__logo" titel="" />
      <span class="kopf__name" aria-hidden="true">
        <span class="kopf__ig">IG</span> Diessbach
      </span>
    </a>

    <button
      class="kopf__menuknopf"
      type="button"
      aria-expanded="false"
      aria-controls="hauptmenu"
      hidden
    >
      <span class="kopf__burger" aria-hidden="true"><span></span></span>
      <span class="kopf__menutext">Menü</span>
    </button>

    <nav id="hauptmenu" class="kopf__nav" aria-label="Hauptmenü">
      <ul>
        {NAV.map((p) => (
          <li>
            <a href={p.href} aria-current={aktiv(p.href) ? 'page' : undefined}>{p.label}</a>
          </li>
        ))}
        <li class="kopf__kontakt">
          <a href="/kontakt/" class="knopf knopf--primaer knopf--klein" aria-current={aktiv('/kontakt/') ? 'page' : undefined}>Kontakt</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Menü am Handy auf- und zuklappen. Ohne JavaScript bleibt das Menü sichtbar.
  const knopf = document.querySelector<HTMLButtonElement>('.kopf__menuknopf');
  const nav = document.getElementById('hauptmenu');
  if (knopf && nav) {
    knopf.hidden = false;
    document.documentElement.classList.add('js-menu');
    const setze = (offen: boolean) => {
      knopf.setAttribute('aria-expanded', String(offen));
      nav.classList.toggle('offen', offen);
    };
    knopf.addEventListener('click', () => setze(knopf.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && knopf.getAttribute('aria-expanded') === 'true') {
        setze(false);
        knopf.focus();
      }
    });
  }
</script>

<style>
  .kopf {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--igd-anthrazit);
    color: var(--igd-weiss);
    border-bottom: 4px solid var(--igd-rot);
  }
  .kopf__innen {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
    flex-wrap: wrap;
  }
  .kopf__marke {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
    padding-block: 0.5rem;
  }
  .kopf__marke :global(.kopf__logo) { width: 2.6rem; height: auto; }
  .kopf__name { font-weight: 800; font-size: 1.35rem; letter-spacing: -0.01em; line-height: 1; }

  .kopf__menuknopf {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.9rem;
    background: transparent;
    color: inherit;
    border: 2px solid rgb(255 255 255 / 0.35);
    border-radius: var(--radius);
    font: inherit;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
  }
  .kopf__menuknopf:hover { border-color: var(--igd-weiss); }
  .kopf__burger, .kopf__burger span, .kopf__burger::before, .kopf__burger::after {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: currentColor;
    transition: transform 0.2s, opacity 0.2s;
  }
  .kopf__burger { position: relative; background: none; height: 14px; }
  .kopf__burger span { position: absolute; top: 6px; }
  .kopf__burger::before, .kopf__burger::after { content: ''; position: absolute; }
  .kopf__burger::before { top: 0; }
  .kopf__burger::after { bottom: 0; }
  [aria-expanded='true'] .kopf__burger span { opacity: 0; }
  [aria-expanded='true'] .kopf__burger::before { transform: translateY(6px) rotate(45deg); }
  [aria-expanded='true'] .kopf__burger::after { transform: translateY(-6px) rotate(-45deg); }

  .kopf__nav { width: 100%; }
  .kopf__nav ul {
    list-style: none;
    margin: 0;
    padding: 0 0 1rem;
    display: flex;
    flex-direction: column;
  }
  .kopf__nav a:not(.knopf) {
    display: block;
    padding: 0.8rem 0;
    color: var(--igd-weiss);
    text-decoration: none;
    font-weight: 600;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }
  .kopf__nav a:not(.knopf):hover { color: #F08A73; }
  .kopf__nav a[aria-current='page']:not(.knopf) { color: #F08A73; }
  .kopf__kontakt { padding-top: 1rem; }

  :global(.js-menu) .kopf__nav:not(.offen) { display: none; }

  @media (min-width: 68rem) {
    .kopf__innen { flex-wrap: nowrap; }
    .kopf__menuknopf { display: none; }
    .kopf__nav, :global(.js-menu) .kopf__nav:not(.offen) { display: block; width: auto; }
    .kopf__nav ul { flex-direction: row; align-items: center; gap: 0.25rem; padding: 0; }
    .kopf__nav a:not(.knopf) {
      border: 0;
      padding: 0.5rem 0.65rem;
      font-size: 1rem;
      border-radius: 0.25rem;
      position: relative;
    }
    .kopf__nav a[aria-current='page']:not(.knopf) { color: var(--igd-weiss); }
    .kopf__nav a[aria-current='page']:not(.knopf)::after {
      content: '';
      position: absolute;
      left: 0.65rem; right: 0.65rem; bottom: 0.1rem;
      height: 3px;
      background: var(--igd-rot-hell);
    }
    .kopf__kontakt { padding-top: 0; margin-left: 0.75rem; }
  }
</style>
