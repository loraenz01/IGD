---
import Base from '../../layouts/Base.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import PersonKarte from '../../components/PersonKarte.astro';
import { aktivePersonen, GREMIEN } from '../../lib/inhalte';

type Gremium = keyof typeof GREMIEN;
const personen = await aktivePersonen();

/**
 * Jedes Gremium wird VOLLSTÄNDIG gezeigt (Entscheid 1.11.2026).
 * Wer in mehreren Gremien ist, erscheint in jedem davon – die Karte zeigt jeweils
 * alle Funktionen, die des aktuellen Abschnitts zuoberst.
 * Reihenfolge: Vorstand wie in personen.json, Behörden «bisher» vor «neu».
 */
const mit = (g: Gremium) => {
  const liste = personen.filter((p) => p.data.rollen.some((r) => r.gremium === g));
  if (g === 'Vorstand') return liste;
  const rang = (p: (typeof liste)[number]) => (p.data.rollen.find((r) => r.gremium === g)?.status === 'bisher' ? 0 : 1);
  return [...liste].sort((a, b) => rang(a) - rang(b));
};

const kommissionen: Gremium[] = ['PBBK', 'Bildungskommission', 'EWK'];
const sitze = (n: number) => (n === 1 ? '1 Sitz' : `${n} Sitze`);
---
<Base titel="Köpfe" beschreibung="Vorstand, Gemeinderat und Kommissionen: die Menschen der IG Diessbach.">
  <Seitenkopf dachzeile="Köpfe" titel="Die Menschen hinter der IG Diessbach" lead="Vorstand und unsere Vertretung in Gemeinderat und Kommissionen – Amtsperiode 2027–2030." />

  <nav class="container sprung" aria-label="Abschnitte">
    <a href="#vorstand">Vorstand</a>
    <a href="#gemeinderat">Gemeinderat</a>
    <a href="#kommissionen">Kommissionen</a>
  </nav>

  <section class="section" id="vorstand">
    <div class="container">
      <h2>Vorstand</h2>
      <div class="raster" style="--min: 15rem">{mit('Vorstand').map((p) => <PersonKarte person={p} gremium="Vorstand" />)}</div>
    </div>
  </section>

  <section class="section section--hell" id="gemeinderat">
    <div class="container">
      <h2>Gemeinderat <span class="sitze">{sitze(mit('Gemeinderat').length)}</span></h2>
      <p class="lead text-breite">Unsere Vertretung im Gemeinderat für die Amtsperiode 1.1.2027–31.12.2030.</p>
      <div class="raster" style="--min: 15rem">{mit('Gemeinderat').map((p) => <PersonKarte person={p} gremium="Gemeinderat" />)}</div>
    </div>
  </section>

  <section class="section" id="kommissionen">
    <div class="container">
      <h2>Kommissionen</h2>
      <p class="lead text-breite">Unsere Vertretung in den Kommissionen der Gemeinde, Amtsperiode 2027–2030.</p>
      {kommissionen.map((g) => (
        <div class="kommission" id={g.toLowerCase()}>
          <h3>{GREMIEN[g].lang} <span class="sitze">{sitze(mit(g).length)}</span></h3>
          <div class="raster" style="--min: 15rem">{mit(g).map((p) => <PersonKarte person={p} gremium={g} ueberschrift="h4" />)}</div>
        </div>
      ))}
    </div>
  </section>
</Base>
<style>
  .sprung { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; padding-block: 1.25rem 0; font-weight: 600; }
  .sitze {
    display: inline-block; vertical-align: middle;
    font-size: 0.875rem; font-weight: 600; letter-spacing: 0.02em;
    color: var(--igd-weiss); background: var(--igd-primaer);
    border-radius: 999px; padding: 0.15rem 0.7rem; margin-left: 0.5rem;
  }
  .kommission { margin-top: 2.5rem; }
  .kommission h3 { font-size: var(--fs-h3); margin-bottom: 1rem; }
</style>
