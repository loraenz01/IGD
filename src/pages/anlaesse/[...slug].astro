---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Teilen from '../../components/Teilen.astro';
import Formular from '../../components/Formular.astro';
import Feld from '../../components/Feld.astro';
import { datumLang } from '../../lib/site';

export async function getStaticPaths() {
  return (await getCollection('anlaesse')).map((a) => ({ params: { slug: a.id }, props: { anlass: a } }));
}
const { anlass } = Astro.props;
const a = anlass.data;
const { Content } = await render(anlass);
const heute = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Zurich' }).format(new Date());
const vergangen = a.datum.toISOString().slice(0, 10) < heute;
const anmeldungOffen = !vergangen && a.anmeldung && (!a.anmeldeschluss || a.anmeldeschluss.toISOString().slice(0, 10) >= heute);
const zeit = a.zeit_von ? `${a.zeit_von.replace(':', '.')}${a.zeit_bis ? `–${a.zeit_bis.replace(':', '.')}` : ''} Uhr` : null;

const event = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: a.titel,
  startDate: a.zeit_von ? `${a.datum.toISOString().slice(0, 10)}T${a.zeit_von}` : a.datum.toISOString().slice(0, 10),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: a.ort, address: a.ort },
  description: a.kurz,
  organizer: { '@type': 'Organization', name: 'IG Diessbach', url: 'https://www.igdiessbach.ch' },
};
---
<Base titel={a.titel} beschreibung={a.kurz}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(event)} />
  <Seitenkopf dachzeile={vergangen ? 'Rückblick' : 'Anlass'} titel={a.titel}>
    <dl class="eckdaten">
      <div><dt>Datum</dt><dd>{datumLang(a.datum)}</dd></div>
      {zeit && <div><dt>Zeit</dt><dd>{zeit}</dd></div>}
      <div><dt>Ort</dt><dd>{a.ort}</dd></div>
      {!vergangen && a.anmeldeschluss && <div><dt>Anmeldeschluss</dt><dd>{datumLang(a.anmeldeschluss)}</dd></div>}
    </dl>
  </Seitenkopf>
  <section class="section">
    <div class="container">
      {a.bild && <Image src={a.bild} alt={a.bild_alt ?? ''} widths={[480, 800, 1200]} sizes="(min-width: 48rem) 800px, 100vw" class="anlass__bild" />}
      <p class="lead text-breite">{a.kurz}</p>
      <div class="prose"><Content /></div>
      {!vergangen && (
        <p class="kalender"><a href={`/anlaesse/${anlass.id}.ics`} class="knopf knopf--sekundaer" download>In Kalender eintragen</a></p>
      )}
      {anmeldungOffen && (
        <div class="anmeldung" id="anmeldung">
          <h2>Anmeldung</h2>
          <Formular name="anmeldung" knopf="Verbindlich anmelden">
            <input type="hidden" name="anlass" value={`${a.titel} (${datumLang(a.datum)})`} />
            <Feld formular="anmeldung" name="name" label="Vorname und Name" pflicht autocomplete="name" />
            <div class="formular__zeile formular__zeile--2">
              <Feld formular="anmeldung" name="personen" label="Anzahl Personen" typ="number" pflicht min={1} max={20} wert={1} />
              <Feld formular="anmeldung" name="kontakt" label="E-Mail oder Telefon" pflicht hilfe="Damit wir Sie bei Änderungen erreichen." />
            </div>
            <Feld formular="anmeldung" name="bemerkung" label="Bemerkung" typ="textarea" />
          </Formular>
        </div>
      )}
      {!vergangen && a.anmeldung && !anmeldungOffen && (
        <p class="anmeldung"><strong>Die Anmeldefrist ist abgelaufen.</strong> Bitte melden Sie sich bei Fragen über das <a href="/kontakt/">Kontaktformular</a>.</p>
      )}
      {a.galerie.length > 0 && (
        <div class="galerie">
          {a.galerie.map((g, i) => <Image src={g} alt={`Foto ${i + 1} vom Anlass «${a.titel}»`} widths={[400, 800]} sizes="(min-width: 48rem) 33vw, 100vw" />)}
        </div>
      )}
      <Teilen titel={a.titel} />
    </div>
  </section>
</Base>
<style>
  .eckdaten { display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; margin: 0; }
  .eckdaten dt { font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--igd-akzent-dunkelgrund); font-weight: 600; }
  .eckdaten dd { margin: 0; font-weight: 600; }
  :global(.anlass__bild) { width: auto; max-width: 100%; max-height: 85vh; object-fit: contain; border-radius: var(--radius); margin-bottom: 2rem; }
  .anmeldung { margin-top: 2.5rem; max-width: var(--breite-text); }
  .kalender { margin-top: 1.5rem; }
  .galerie { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); margin-top: 2rem; }
  .galerie :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); }
</style>
