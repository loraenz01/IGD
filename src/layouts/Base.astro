---
import '@fontsource/fira-sans/latin-400.css';
import '@fontsource/fira-sans/latin-600.css';
import '@fontsource/fira-sans/latin-800.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, IST_LIVE, BASIS_URL } from '../lib/site';

interface Props {
  titel?: string;
  beschreibung?: string;
  ogBild?: string;
}
const { titel, beschreibung = SITE.beschreibung, ogBild = '/og-standard.png' } = Astro.props;
const voller_titel = titel ? `${titel} – ${SITE.name}` : `${SITE.name} – ${SITE.claim}`;
const kanonisch = new URL(Astro.url.pathname, BASIS_URL);
const ogUrl = new URL(ogBild, BASIS_URL);

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.langname,
  alternateName: SITE.name,
  url: SITE.url,
  logo: new URL('/apple-touch-icon.png', SITE.url).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.adresse.strasse,
    postalCode: '3264',
    addressLocality: 'Diessbach bei Büren',
    addressCountry: 'CH',
  },
};
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Menü am Handy sofort eingeklappt darstellen (verhindert Springen beim Laden) -->
    <script is:inline>document.documentElement.classList.add('js-menu');</script>
    <title>{voller_titel}</title>
    <meta name="description" content={beschreibung} />
    {!IST_LIVE && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={kanonisch} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1F2523" />

    <!-- Vorschau beim Teilen (WhatsApp, Facebook usw.) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={titel ?? `${SITE.name} – ${SITE.claim}`} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(organisation)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Direkt zum Inhalt</a>
    <Header />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
